{
  "name": "pi-hashline-edit-pro",
  "version": "2.8.1",
  "type": "module",
  "description": "Hash-anchored read/replace/insert/grep tools for pi-coding-agent. Every line gets a unique 3-char hash (A-Za-z0-9) that stays stable across edits; stale or ambiguous anchors are rejected, never fuzzy-matched. Undo persists across restarts.",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGiMob/pi-hashline-edit-pro.git"
  },
  "author": "pi-hashline-edit-pro contributors",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "hashline",
    "hash-anchored",
    "hash",
    "anchors",
    "read",
    "replace",
    "edit",
    "undo",
    "file-editing",
    "stable"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "diff": "^9.0.0",
    "file-type": "^22.0.2",
    "typebox": "^1.3.7",
    "xxhash-wasm": "^1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.functions=85 --coverage.thresholds.branches=80",
    "lint": "eslint \"src/**/*.ts\" \"index.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "koffi@2.16.2": true,
    "protobufjs@7.6.4": true
  }
}
